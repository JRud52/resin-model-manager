# Copy to `.env` for docker compose, or enter these in Portainer's
# "Environment variables" section. Anything left out uses the default shown.
SOURCE_PATH=/volume1/3d-models
LIBRARY_PATH=/volume1/resin-manager/library
DATA_PATH=/volume1/resin-manager/data
PUID=1000
PGID=1000
PORT=8080
RELEASE_DEPTH=0
PREVIEW_WORKERS=1
PRERENDER=1
SCAN_INTERVAL_MINUTES=0
MAX_PREVIEW_MB=1024

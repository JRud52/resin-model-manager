# Copy to `.env` for docker compose, or enter these in Portainer's
# "Environment variables" section. Anything left out uses the default shown.
# The app's database, settings and preview cache.
DATA_PATH=/volume1/docker/resin-manager
# Your model library: imported files are copied here.
LIBRARY_PATH=/volume1/3d-library
# Optional: an existing library to copy in from the Import dialog.
# SOURCE_PATH=/volume1/3d-models
PUID=1000
PGID=1000
PORT=8417
# Optional: sign in through Authelia. See the README, "Signing in with Authelia".
# AUTH_PROXY=1
# AUTH_PROXY_TRUSTED=172.20.0.5
# AUTH_PROXY_ADMIN_GROUP=admins
# AUTH_PROXY_LOGOUT_URL=https://auth.example.com/logout
# Optional: a "Sign in with Authelia" button (OpenID Connect). See the README.
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=models
# OIDC_CLIENT_SECRET=the-client-secret
# OIDC_ADMIN_GROUP=admins
